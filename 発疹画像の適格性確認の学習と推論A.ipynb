        "#推論用のネットワークの定義\n",
        "class AutoEncoder2(pl.LightningModule):\n",
        "\n",
        "    # encoder, decoder を合体\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "\n",
        "        self.encoder = Encoder()\n",
        "        self.decoder = Decoder()\n",
        "\n",
        "    # 順伝播\n",
        "    def forward(self, x):\n",
        "        h = self.encoder(x)\n",
        "        h = self.decoder(h)\n",
        "        return h"
      ],
      "metadata": {
        "id": "-jQbiPJXzBnj"
      },
      "execution_count": 44,
      "outputs": []
    },
